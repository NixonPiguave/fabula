{
  "name": "fabula-desktop",
  "version": "0.6.0",
  "description": "Tus textos, con voz: lecturas, novelas, documentos y audiolibros",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/main/index.js",
  "author": "Fábula",
  "overrides": {
    "global-agent": "4.1.3"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "setup:desktop": "node node_modules/electron/install.js",
    "start": "electron-vite preview",
    "build": "npm run licenses && npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && node tools/package.mjs",
    "package:installer": "npm run build && node tools/package.mjs --installer",
    "smoke": "node tools/smoke.mjs",
    "fixtures": "node tools/generate-sample.mjs",
    "test:desktop": "node tools/run-desktop-check.mjs",
    "test:advanced": "node tools/run-desktop-check.mjs tools/advanced-check.cjs",
    "test:library": "node tools/run-desktop-check.mjs tools/library-check.cjs",
    "test:voices-pdf": "node tools/run-desktop-check.mjs tools/voices-pdf-check.cjs",
    "build:icon": "node tools/create-icon.mjs",
    "package:all": "npm run build && node tools/package.mjs --all",
    "test:profiles": "node tools/run-desktop-check.mjs tools/profiles-check.cjs",
    "licenses": "node tools/license-notices.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:languages": "node tools/run-desktop-check.mjs tools/languages-check.cjs"
  },
  "build": {
    "appId": "com.fabula.desktop",
    "productName": "Fabula",
    "directories": {
      "output": ".build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "TERCEROS.txt",
      "LICENSE.txt",
      "assets/**/*",
      "PRIVACIDAD.txt",
      "AVISOS_DE_USO.txt",
      "LICENCIAS_DE_COMPONENTES.txt",
      "docs/en/*.txt"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "assets/native/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Fabula-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "Fabula-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "perMachine": false,
      "allowElevation": false,
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "include": "assets/installer/language.nsh"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "docx": "9.12.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "html-to-text": "10.0.1",
    "lucide-react": "1.58.0",
    "msedge-tts": "2.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rtf-parser": "1.3.3",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NixonPiguave/fabula.git"
  },
  "homepage": "https://github.com/NixonPiguave/fabula#readme",
  "bugs": {
    "url": "https://github.com/NixonPiguave/fabula/issues"
  }
}
